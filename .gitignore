# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
AGENTS.md
CLAUDE.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production builds
/build
/dist

# typescript
*.tsbuildinfo
next-env.d.ts

# env files
.env
.env.*
!.env.example

# runtime generated task output (JSON documents, exported images, cached stock assets)
/output/json/*
/output/export/*
/output/assets/*
!/output/json/.gitkeep
!/output/export/.gitkeep
!/output/assets/.gitkeep

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editor / IDE
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# misc
*.pem
.vercel
.turbo

# local tool state
/.claude/
